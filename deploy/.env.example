# 复制本文件为 .env 并填入真实值
# 生产环境务必使用强密码和随机密钥，不要保留示例值

# MySQL root 密码
DB_PASSWORD=change-me-strong-password

# JWT 签名密钥：64 位十六进制
# 生成方法（Linux）：openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars-random

# 答题门禁答案：访客必须答对该题才能访问公开页面
# 注意：真实答案绝不能写进任何 git 跟踪的文件，只在服务器 .env 中填写
GATE_ANSWER=change-me-gate-answer

# 答题门禁凭证签名密钥：生成方法 openssl rand -hex 32；留空则复用 JWT_SECRET
GATE_SECRET=
